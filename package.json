{
  "name": "dsh-wallpaper-cnr",
  "version": "0.0.7",
  "type": "module",
  "description": "Personal wallpaper for the DeepSeek Harness workspace and startup screen, with a settings page for uploading your own image.",
  "license": "MIT",
  "author": "CNRuiRen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CNRuiRen/dsh-custom-plugin.git"
  },
  "homepage": "https://github.com/CNRuiRen/dsh-custom-plugin#readme",
  "bugs": {
    "url": "https://github.com/CNRuiRen/dsh-custom-plugin/issues"
  },
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "plugin",
    "wallpaper"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "提示.md",
    "docs/wallpaper-preview.jpg",
    "docs/generate-preview.py",
    "docs/show_0.PNG",
    "docs/show_1.PNG"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  }
}
